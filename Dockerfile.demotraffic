# Demo traffic generator - runs the 20-request demo load fully inside Docker
# so `make demo` needs only Docker, never a local Go toolchain.
FROM golang:1.25 AS build
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /demotraffic ./cmd/demotraffic

FROM alpine:latest
COPY --from=build /demotraffic /demotraffic
ENTRYPOINT ["/demotraffic"]
