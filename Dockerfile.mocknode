FROM golang:1.25.12-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o /mocknode ./cmd/mocknode

FROM alpine:latest
RUN apk --no-cache add wget
COPY --from=builder /mocknode /mocknode
EXPOSE 11434
ENTRYPOINT ["/mocknode"]
