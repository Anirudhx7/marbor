# Anchored to the repo root: a bare "marbor" would also ignore cmd/marbor/ (and
# cmd/marbor-agent/), silently dropping new source files added under them.
/marbor
/marbor.exe
/marbor-agent
/marbor-agent.exe
# Same names if someone runs a bare `go build` inside a cmd directory.
/cmd/marbor/marbor
/cmd/marbor-agent/marbor-agent
ui/node_modules/
internal/admin/web/dist/
*.exe

# Audit logs
*.log
audit.log

# Environment files
.env
.env.local
.local/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build artifacts
dist/

# Runtime per-key usage/quota state
usage-state.json
usage-state.json.tmp

# Stray go build outputs (use make/-o, never bare `go build ./cmd/...`)
/demotraffic
/mockollama
/demo
nul

# Git worktrees
.worktrees/
marbor.db
marbor.db-journal
marbor.db-wal
marbor.db-shm
marbor.db.key

# Go testing/coverage
*.test
*.out
*.prof

# General Node / NPM
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

CLAUDE.md
